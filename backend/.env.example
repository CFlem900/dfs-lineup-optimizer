# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# NBA API Configuration
NBA_API_TIMEOUT=30
NBA_API_MAX_RETRIES=3
NBA_API_RETRY_DELAY=2

# Cache TTL (in seconds)
CACHE_TTL_BASELINE=86400
CACHE_TTL_ROTATION=300
CACHE_TTL_INJURIES=600

# PostgreSQL (leave empty to disable database layer)
DATABASE_URL=

# Scraping (set to false for mock data during development)
SCRAPING_ENABLED=false

# Twitter / X API (required for live Twitter signals)
# Get a bearer token at https://developer.twitter.com/en/portal/dashboard
# Essential tier ($100/mo) provides 450 req/15min — recommended for production
TWITTER_BEARER_TOKEN=

# ── AI Agent Configuration ────────────────────────────────────
# Provider: "anthropic" or "openai" (determines which key is used)
AI_PROVIDER=anthropic

# Set to false to disable all 11 AI agents (app falls back to rule-based logic)
AI_ENABLED=true

# Anthropic (Claude) — get your key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI — get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Model overrides (defaults are cost-efficient; uncomment to change)
# ANTHROPIC_MODEL_DEFAULT=claude-haiku-4-5-20251001
# ANTHROPIC_MODEL_REASONING=claude-sonnet-4-20250514
# OPENAI_MODEL_DEFAULT=gpt-4o-mini
# OPENAI_MODEL_REASONING=gpt-4o

# AI tuning
AI_MAX_RETRIES=3
AI_TIMEOUT=30
AI_CACHE_TTL=900

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
